{
  "manifest_version": 3,
  "name": "Lovefilter — hide hate, keep the debate",
  "version": "0.2.0",
  "description": "Uses AI to hide hate & harassment in your feed, keeps honest disagreement, and lifts the kind replies. Reversible, no tracking.",
  "permissions": ["storage"],
  "host_permissions": ["https://vakt.aeris.no/*"],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lovefilter",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
